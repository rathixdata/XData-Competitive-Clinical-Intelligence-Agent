# =============================================================================
# XData Competitive & Clinical Intelligence Agent: environment configuration
#
#   cp .env.example .env        (never commit .env)
#
# The defaults run fully offline: LLM_PROVIDER=offline and EMBEDDING_PROVIDER=hashing,
# so no API keys are needed. App settings use the XDATA_ prefix (backend/app/core/config.py).
# Values here are written for running the API on the host (`make dev-api`). The compose
# stack (`make up`) overrides the network endpoints (DB, redis, S3) with its own service
# names. In staging and production, secrets come from AWS Secrets Manager through
# external-secrets, not from this file.
# JSON values (lists) are single-quoted so both docker compose and `source .env` parse them.
# Optional settings are commented out: an EMPTY value is read as "" (not unset) by the app.
# =============================================================================

# ---- runtime -----------------------------------------------------------------
# development | test | staging | production. Production refuses to start unless
# XDATA_JWT_SECRET, XDATA_FIELD_ENCRYPTION_KEY and XDATA_WEBHOOK_SIGNING_SECRET are set.
XDATA_ENV=development
XDATA_SERVICE_NAME=xdata-ci-agent
XDATA_LOG_LEVEL=INFO
# JSON logs; set false for human-readable local output
XDATA_LOG_JSON=false
XDATA_API_PREFIX=/api/v1
# Browser origins allowed by CORS (JSON list)
XDATA_CORS_ORIGINS='["http://localhost:5173","http://localhost:8080"]'
# Base URL used in links inside alerts, emails and reports
XDATA_PUBLIC_BASE_URL=http://localhost:5173

# ---- PostgreSQL 16 + pgvector ------------------------------------------------
# App role: must NOT be a superuser (Row-Level Security enforces tenant isolation).
XDATA_DATABASE_URL=postgresql+psycopg://xdata:xdata@localhost:5432/xdata
XDATA_DB_POOL_SIZE=10
XDATA_DB_MAX_OVERFLOW=20
XDATA_DB_STATEMENT_TIMEOUT_MS=15000

# ---- Redis / Celery ------------------------------------------------------------
# Production: rediss://:<auth-token>@<elasticache-endpoint>:6379/0 (TLS + AUTH)
XDATA_REDIS_URL=redis://localhost:6379/0
# Optional overrides; both default to XDATA_REDIS_URL
# XDATA_CELERY_BROKER_URL=
# XDATA_CELERY_RESULT_BACKEND=
# Run tasks inline, with no worker (tests / quick demos)
XDATA_CELERY_EAGER=false

# ---- object store (immutable raw source retention) ---------------------------
# local = filesystem under XDATA_OBJECT_STORE_LOCAL_PATH; s3 = S3 / MinIO
XDATA_OBJECT_STORE_BACKEND=local
XDATA_OBJECT_STORE_LOCAL_PATH=./.data/objects
XDATA_S3_BUCKET=xdata-ci-raw
XDATA_S3_REGION=us-east-1
# MinIO from the host: http://localhost:9000. Leave empty for real AWS S3.
# XDATA_S3_ENDPOINT_URL=
# KMS key for SSE-KMS (production: alias/xdata-production-s3)
# XDATA_S3_KMS_KEY_ID=
# Static S3 credentials: local MinIO only. On EKS use IRSA and leave these unset.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- security ------------------------------------------------------------------
# HS256 signing key for local tokens. Use >= 32 random bytes: `openssl rand -base64 48`
XDATA_JWT_SECRET=dev-only-change-me-dev-only-change-me
XDATA_JWT_ISSUER=xdata-ci-agent
XDATA_JWT_AUDIENCE=xdata-ci-api
XDATA_ACCESS_TOKEN_TTL_MINUTES=60
# Fernet key for application-level encryption of stored credentials and webhook URLs.
# Generate with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Optional in development, mandatory in production.
# XDATA_FIELD_ENCRYPTION_KEY=
# HMAC secret used to sign outbound alert webhooks (mandatory in production)
XDATA_WEBHOOK_SIGNING_SECRET=dev-webhook-secret
XDATA_API_RATE_LIMIT_PER_MINUTE=300
XDATA_ASK_RATE_LIMIT_PER_MINUTE=20
# Username/password login; disable when enterprise SSO is enforced
XDATA_LOCAL_AUTH_ENABLED=true

# ---- enterprise SSO (OIDC). Leave empty to disable. ----------------------------
# e.g. https://login.microsoftonline.com/<tenant>/v2.0 or https://<org>.okta.com
# XDATA_OIDC_ISSUER=
# XDATA_OIDC_AUDIENCE=
# XDATA_OIDC_JWKS_URL=
XDATA_OIDC_TENANT_CLAIM=xdata_tenant
XDATA_OIDC_ROLES_CLAIM=xdata_roles
XDATA_OIDC_REQUIRE_MFA=false

# ---- LLM (Anthropic) ---------------------------------------------------------
# offline = deterministic local generator (no key); anthropic = Claude API
XDATA_LLM_PROVIDER=offline
# XDATA_ANTHROPIC_API_KEY=
XDATA_LLM_MODEL=claude-opus-5
XDATA_LLM_VALIDATOR_MODEL=claude-opus-5
# low | medium | high | xhigh | max
XDATA_LLM_EFFORT=high
XDATA_LLM_VALIDATOR_EFFORT=medium
XDATA_LLM_MAX_TOKENS=16000
XDATA_LLM_TIMEOUT_SECONDS=180
XDATA_LLM_SERVER_SIDE_FALLBACK=true
# Per-tenant monthly LLM budget in USD (0 disables the guard)
XDATA_LLM_MONTHLY_BUDGET_USD=0

# ---- embeddings / RAG ------------------------------------------------------------
# hashing = local deterministic embeddings (no key); voyage = Voyage AI
XDATA_EMBEDDING_PROVIDER=hashing
# XDATA_VOYAGE_API_KEY=
XDATA_EMBEDDING_MODEL=voyage-3.5
# Must match the pgvector column dimension used by migrations
XDATA_EMBEDDING_DIM=1024
XDATA_RERANK_ENABLED=false
XDATA_RERANK_MODEL=rerank-2.5
XDATA_RAG_TOP_K=12
XDATA_RAG_CANDIDATE_K=60
XDATA_RAG_CHUNK_TOKENS=350
XDATA_RAG_CHUNK_OVERLAP=60
XDATA_RAG_RRF_K=60

# ---- public data connectors ----------------------------------------------------
# NCBI E-utilities (PubMed). Optional key raises the rate limit from 3 to 10 req/s.
# XDATA_NCBI_API_KEY=
XDATA_NCBI_TOOL=xdata-ci-agent
XDATA_NCBI_EMAIL=ops@example.com
# openFDA (optional key, higher rate limit)
# XDATA_OPENFDA_API_KEY=
# SEC EDGAR requires a descriptive User-Agent with a contact email
XDATA_SEC_USER_AGENT='XData CI Agent ops@example.com'
XDATA_CONNECTOR_HTTP_TIMEOUT=30
XDATA_CONNECTOR_USER_AGENT='XData-CI-Agent/1.0 (+https://xdata.example.com)'

# ---- alert delivery (email via SMTP; e.g. Amazon SES) ----------------------------
# Leave XDATA_SMTP_HOST empty to disable email delivery locally
# XDATA_SMTP_HOST=
XDATA_SMTP_PORT=587
# XDATA_SMTP_USERNAME=
# XDATA_SMTP_PASSWORD=
XDATA_SMTP_FROM=intelligence@xdata.example.com

# ---- observability -------------------------------------------------------------
# OTLP gRPC endpoint for traces, e.g. http://otel-collector:4317 (empty disables)
# XDATA_OTEL_EXPORTER_OTLP_ENDPOINT=
# Prometheus /metrics endpoint
XDATA_METRICS_ENABLED=true

# ---- docker compose only (deploy/docker-compose.yml) ------------------------------
# Password of the non-superuser app role created by deploy/postgres/init/01-init.sql.
# Only applied when the pgdata volume is first created.
XDATA_DB_PASSWORD=xdata
POSTGRES_SUPERUSER_PASSWORD=postgres
MINIO_ROOT_USER=xdataminio
MINIO_ROOT_PASSWORD=xdataminio-secret
GRAFANA_ADMIN_PASSWORD=admin
# uvicorn worker processes (API container) and Celery concurrency
WEB_CONCURRENCY=2
CELERY_CONCURRENCY=4
# Host ports
API_HOST_PORT=8000
WEB_HOST_PORT=8080
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
